                "exec": [
                  "pm.test('v2 summarize returns 202 async-ops contract (ADR-3)', function () { pm.expect(pm.response.code).to.be.oneOf([202, 503]); });",
                  "var body = pm.response.json();",
                  "if (pm.response.code === 202) {",
                  "  pm.test('v2 summarize accepted envelope', function () { pm.expect(body.status).to.equal('accepted'); pm.expect(body.operation_id).to.be.a('string').and.not.empty; pm.expect(body.status_url).to.equal('/api/operations/' + body.operation_id); });",
                  "  pm.test('v2 summarize operation_id is URL-safe', function () { pm.expect(body.operation_id).to.match(/^v2-summarize-[0-9a-f]+$/); });",
                  "} else {",
                  "  pm.test('v2 store-unavailable failure is structured', function () { pm.expect(body.detail || body.error || body.title).to.exist; });",

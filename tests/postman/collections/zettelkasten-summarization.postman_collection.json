              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": []
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('List endpoint schema', function () { pm.expect(pm.response.code).to.equal(200); pm.expect(body.zettels).to.be.an('array'); pm.expect(body.total).to.be.a('number'); });",
                  "pm.test('No duplicate zettel ids in list', function () { var ids = body.zettels.map(function (z) { return z.id; }); pm.expect(new Set(ids).size).to.equal(ids.length); });",
                  "pm.test('No blank Untitled regression in ready items', function () { body.zettels.forEach(function (z) { pm.expect(z.title, 'title for ' + z.id).to.not.equal('Untitled'); }); });",
                  "pm.test('List items expose title_ready / enrichment_status readiness signal', function () { body.zettels.forEach(function (z) { pm.expect(z, 'readiness fields for ' + z.id).to.include.keys('title_ready', 'enrichment_status'); pm.expect(z.enrichment_status, 'enrichment_status for ' + z.id).to.be.oneOf(['ready', 'pending']); pm.expect(z.title_ready, 'title_ready for ' + z.id).to.be.a('boolean'); if (z.title_ready === true) { pm.expect(z.enrichment_status).to.equal('ready'); } else { pm.expect(z.enrichment_status).to.equal('pending'); } }); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token_user_a}}" }

{
  "info": {
    "_postman_id": "2b3f44b1-c3c1-4bbf-a97b-zk-summarization",
    "name": "Zettelkasten Summarization E2E",
    "description": "End-to-end Postman/Newman suite for Add Zettel, summarization v2, operation polling, UI-triggered surfaces, Supabase write verification, user scoping, failure handling, and timing reports. Built from docs/research/postman_init1.md and docs/research/postman_init2.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('run_id')) {",
          "  pm.environment.set('run_id', 'postman-' + Date.now() + '-' + Math.random().toString(36).slice(2));",
          "}",
          "if (!pm.environment.get('latency_events_json')) {",
          "  pm.environment.set('latency_events_json', '[]');",
          "}",
          "// Live gate: skip every request unless explicitly hitting a real target.",
          "if (String(pm.environment.get('run_live_requests') || '').toLowerCase() !== 'true') {",
          "  pm.test('SKIPPED: set run_live_requests=true to hit a real target', function () { pm.expect(true).to.equal(true); });",
          "  pm.execution.skipRequest();",
          "}",
          "// Per-request required-variable gate. Centralized in the collection",
          "// pre-request because Postman runs each script in its own sandbox -",
          "// a helper defined in one script is NOT in scope in another. The",
          "// collection pre-request DOES run before every request and can read",
          "// pm.info.requestName, so all gating lives here.",
          "var ZK_REQUIRE = {",
          "  'P1 Home button fires authenticated POST /api/zettels/add': ['auth_token_user_a'],",
          "  'P1 Zettels page button fires POST /api/zettels/add': ['auth_token_user_a'],",
          "  'P1 Poll home operation until terminal or budget': ['auth_token_user_a', 'op_url_home'],",
          "  'P1 User A list contains only scoped zettels': ['auth_token_user_a'],",
          "  'P1 User B cannot read User A operation payload': ['auth_token_user_b', 'op_url_home'],",
          "  'P1 Supabase workspace row exists for persisted zettel': ['supabase_url', 'supabase_service_role_key', 'workspace_zettel_id'],",
          "  'P1 Supabase canonical row is scoped': ['supabase_url', 'supabase_service_role_key', 'canonical_zettel_id'],",
          "  'P1 Supabase operation response keeps full payload': ['supabase_url', 'supabase_service_role_key', 'op_url_home'],",
          "  'P2 Supabase chunks or enrichment state is visible': ['supabase_url', 'supabase_service_role_key', 'canonical_zettel_id']",
          "};",
          "var zkNeeded = ZK_REQUIRE[pm.info.requestName] || [];",
          "var zkMissing = zkNeeded.filter(function (name) { return !pm.environment.get(name); });",
          "if (zkMissing.length) {",
          "  pm.test('SKIPPED: ' + pm.info.requestName + ' needs ' + zkMissing.join(', '), function () { pm.expect(true).to.equal(true); });",
          "  pm.execution.skipRequest();",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "var raw = pm.environment.get('latency_events_json') || '[]';",
          "var events = [];",
          "try { events = JSON.parse(raw); } catch (e) { events = []; }",
          "events.push({",
          "  request: pm.info.requestName,",
          "  folder: pm.info.folderName || '',",
          "  status: pm.response.code,",
          "  elapsed_ms: pm.response.responseTime,",
          "  at: new Date().toISOString()",
          "});",
          "pm.environment.set('latency_events_json', JSON.stringify(events));"
        ]
      }
    }
  ],

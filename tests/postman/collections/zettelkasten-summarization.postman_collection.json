    {
      "name": "P1 Website-triggered Add Zettel",
      "item": [
        {
          "name": "P1 Landing button fires POST /api/zettels/add",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var id = pm.environment.get('run_id') + ':landing';",
                  "pm.variables.set('client_action_id', id);",
                  "pm.variables.set('surface', 'landing');",
                  "pm.variables.set('url_under_test', pm.environment.get('test_url_web'));",
                  "pm.variables.set('persist_flag', 'false');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('Landing returns 202 async contract', function () { pm.expect(pm.response.code).to.equal(202); pm.expect(body.status).to.equal('accepted'); });",
                  "pm.test('Correct endpoint and headers fired', function () { pm.expect(pm.request.url.getPath()).to.equal('/api/zettels/add'); pm.expect(pm.response.headers.get('Location')).to.match(/^\\/api\\/operations\\//); pm.expect(pm.response.headers.get('Retry-After')).to.match(/^\\d+$/); });",
                  "pm.test('Accepted response schema', function () { pm.expect(body.operation_id).to.equal(pm.variables.get('client_action_id')); pm.expect(body.status_url).to.equal('/api/operations/' + body.operation_id); pm.expect(body.persistence).to.be.an('object'); pm.expect(body.quality).to.be.an('object'); });",
                  "pm.environment.set('op_url_landing', body.operation_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{client_action_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{url_under_test}}\",\n  \"client_action_id\": \"{{client_action_id}}\",\n  \"persist\": false,\n  \"surface\": \"{{surface}}\"\n}"
            },
            "url": "{{base_url}}/api/zettels/add"
          }
        },
        {
          "name": "P1 Home button fires authenticated POST /api/zettels/add",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var id = pm.environment.get('run_id') + ':home';",
                  "pm.variables.set('client_action_id', id);",
                  "pm.variables.set('surface', 'home');",
                  "pm.variables.set('url_under_test', pm.environment.get('test_url_web'));",
                  "pm.variables.set('persist_flag', pm.environment.get('persist_live_writes') === 'true' ? 'true' : 'false');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('Home returns 202 async contract', function () { pm.expect(pm.response.code).to.equal(202); pm.expect(body.status).to.equal('accepted'); });",
                  "pm.test('Idempotency-Key binds operation id', function () { pm.expect(body.operation_id).to.be.a('string').and.not.empty; pm.expect(body.status_url).to.equal('/api/operations/' + body.operation_id); });",
                  "pm.environment.set('op_url_home', body.operation_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token_user_a}}" },
              { "key": "Idempotency-Key", "value": "{{client_action_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{url_under_test}}\",\n  \"client_action_id\": \"{{client_action_id}}\",\n  \"persist\": {{persist_flag}},\n  \"surface\": \"{{surface}}\"\n}"
            },
            "url": "{{base_url}}/api/zettels/add"
          }
        },
        {
          "name": "P1 Zettels page button fires POST /api/zettels/add",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.environment.get('allow_slow_live_paths') !== 'true') { pm.variables.set('url_under_test', pm.environment.get('test_url_web')); } else { pm.variables.set('url_under_test', pm.environment.get('test_url_youtube')); }",
                  "var id = pm.environment.get('run_id') + ':zettels';",
                  "pm.variables.set('client_action_id', id);",
                  "pm.variables.set('surface', 'zettels');",
                  "pm.variables.set('persist_flag', pm.environment.get('persist_live_writes') === 'true' ? 'true' : 'false');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('Zettels returns 202 async contract', function () { pm.expect(pm.response.code).to.equal(202); pm.expect(body.status).to.equal('accepted'); });",
                  "pm.test('Status URL is pollable operation endpoint', function () { pm.expect(body.status_url).to.match(/^\\/api\\/operations\\//); });",
                  "pm.environment.set('op_url_zettels', body.operation_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token_user_a}}" },
              { "key": "Idempotency-Key", "value": "{{client_action_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{url_under_test}}\",\n  \"client_action_id\": \"{{client_action_id}}\",\n  \"persist\": {{persist_flag}},\n  \"surface\": \"{{surface}}\"\n}"
            },
            "url": "{{base_url}}/api/zettels/add"
          }
        },
        {
          "name": "P1 Poll home operation until terminal or budget",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var notBefore = Number(pm.environment.get('next_poll_not_before_ms') || 0);",
                  "while (Date.now() < notBefore) { /* local runner wait; avoids hammering the app */ }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "var attempts = Number(pm.environment.get('home_poll_attempts') || 0) + 1;",
                  "pm.environment.set('home_poll_attempts', String(attempts));",
                  "pm.test('Status endpoint returns active or terminal contract', function () { pm.expect(pm.response.code).to.be.oneOf([200, 202, 410]); pm.expect(body.operation_id).to.equal(pm.environment.get('op_url_home')); });",
                  "if (pm.response.code === 202 && attempts < Number(pm.environment.get('poll_max_attempts') || 90)) {",
                  "  var retryAfter = parseInt(pm.response.headers.get('Retry-After') || '', 10);",
                  "  var baseSleep = Number(pm.environment.get('poll_sleep_ms') || 2000);",
                  "  var waitMs = retryAfter > 0 ? retryAfter * 1000 : Math.min(baseSleep * Math.pow(2, Math.min(attempts - 1, 4)), 30000);",
                  "  pm.environment.set('next_poll_not_before_ms', String(Date.now() + waitMs));",
                  "  postman.setNextRequest('P1 Poll home operation until terminal or budget');",
                  "} else {",
                  "  pm.environment.unset('home_poll_attempts');",
                  "  pm.environment.unset('next_poll_not_before_ms');",
                  "  pm.test('Terminal or bounded poll exhaustion is explicit', function () { pm.expect(pm.response.code).to.be.oneOf([200, 202, 410]); });",
                  "  if (body.status === 'succeeded') {",
                  "    pm.expect(body.summary).to.be.an('object');",
                  "    pm.environment.set('workspace_zettel_id', body.workspace_zettel_id || '');",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token_user_a}}" }
            ],
            "url": "{{base_url}}/api/operations/{{op_url_home}}"
          }
        }
      ]
    },

                  "pm.test('Accepted envelope shape', function () { pm.expect(body.status).to.equal('accepted'); pm.expect(body.operation_id).to.be.a('string').and.not.empty; pm.expect(body.status_url).to.match(/^\\/api\\/rag\\/sandboxes\\/operations\\//); });",
                  "pm.test('Location + Retry-After headers', function () { pm.expect(pm.response.headers.get('Location')).to.match(/^\\/api\\/rag\\/sandboxes\\/operations\\//); pm.expect(pm.response.headers.get('Retry-After')).to.match(/^\\d+$/); });",
                  "pm.environment.set('kasten_op_id', body.operation_id);"

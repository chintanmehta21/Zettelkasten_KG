                  "pm.variables.set('kasten_name', 'pm-links-' + pm.environment.get('run_id').slice(-8));",
                  "pm.variables.set('link_under_test', pm.environment.get('test_url_web') || 'https://news.ycombinator.com/');"
                ]
              }

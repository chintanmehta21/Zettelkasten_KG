              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unified URL is BOLA-safe (operations_repo user_id filter)', function () { pm.expect(pm.response.code).to.be.oneOf([200, 202, 404, 410]); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token_user_b}}" }
            ],
            "url": "{{base_url}}/api/operations/{{kasten_op_id}}"
          }
        }
      ]
    },
    {
      "name": "P1 Idempotency-Key + cancel",
      "item": [
        {
          "name": "P1 Idempotency-Key header overrides client_action_id",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var hdr = pm.environment.get('run_id') + ':idem-hdr';",
                  "var body = pm.environment.get('run_id') + ':idem-body';",
                  "pm.variables.set('idem_header', hdr);",
                  "pm.variables.set('idem_body', body);",
                  "pm.variables.set('kasten_name', 'pm-idem-' + pm.environment.get('run_id').slice(-8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 202 accepted', function () { pm.expect(pm.response.code).to.equal(202); });",
                  "var body = pm.response.json();",
                  "pm.test('Header wins over body client_action_id', function () { pm.expect(body.operation_id).to.equal(pm.variables.get('idem_header')); pm.expect(body.status_url).to.include(pm.variables.get('idem_header')); });",
                  "pm.environment.set('kasten_op_id_cancel', body.operation_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token_user_a}}" },
              { "key": "Idempotency-Key", "value": "{{idem_header}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{kasten_name}}\",\n  \"default_quality\": \"fast\",\n  \"selection_mode\": \"all\",\n  \"client_action_id\": \"{{idem_body}}\"\n}"
            },
            "url": "{{base_url}}/api/rag/sandboxes"
          }
        },
        {
          "name": "P1 DELETE cancel with matching Idempotency-Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cancel returns 200', function () { pm.expect(pm.response.code).to.equal(200); });",
                  "var body = pm.response.json();",
                  "pm.test('Status is cancelled or noop', function () { pm.expect(body.status).to.be.oneOf(['cancelled', 'noop']); pm.expect(body.operation_id).to.equal(pm.environment.get('kasten_op_id_cancel')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token_user_a}}" },
              { "key": "Idempotency-Key", "value": "{{kasten_op_id_cancel}}" }
            ],
            "url": "{{base_url}}/api/rag/sandboxes/operations/{{kasten_op_id_cancel}}"
          }
        },
        {
          "name": "P1 DELETE cancel with mismatched key is 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Mismatched Idempotency-Key returns 403', function () { pm.expect(pm.response.code).to.equal(403); });",
                  "var body = pm.response.json();",
                  "pm.test('RFC 9457 problem+json body', function () { pm.expect(body.type).to.match(/forbidden|operation_cancel_idempotency_mismatch/); pm.expect(body.status).to.equal(403); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token_user_a}}" },
              { "key": "Idempotency-Key", "value": "WRONG-KEY-DOES-NOT-MATCH" }
            ],
            "url": "{{base_url}}/api/rag/sandboxes/operations/{{kasten_op_id_cancel}}"
          }
        }
      ]
    },

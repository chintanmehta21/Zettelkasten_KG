            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create-with-links returns 202 async', function () { pm.expect(pm.response.code).to.equal(202); });",
                  "var body = pm.response.json();",
                  "pm.test('Accepted envelope shape', function () { pm.expect(body.status).to.equal('accepted'); pm.expect(body.operation_id).to.be.a('string'); });",
                  "pm.test('Selection mode inferred to links', function () { pm.expect(body.status_url).to.match(/^\\/api\\/rag\\/sandboxes\\/operations\\//); });",
                  "pm.environment.set('kasten_op_id', body.operation_id);"
                ]
              }

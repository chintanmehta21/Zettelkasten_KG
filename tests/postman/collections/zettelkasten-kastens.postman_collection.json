        {
          "name": "P1 Create Kasten selection_mode=specific (async)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var id = pm.environment.get('run_id') + ':kasten-specific';",
                  "pm.variables.set('client_action_id', id);",
                  "pm.variables.set('kasten_name', 'pm-specific-' + pm.environment.get('run_id').slice(-8));",
                  "// Caller must supply a known workspace_zettel_id via the env file; if",
                  "// missing the body sends a UUIDv4 placeholder and the runner emits a",
                  "// FailedLink for it (orphan id — proves the BOLA validator works).",
                  "if (!pm.environment.get('seed_workspace_zettel_id')) {",
                  "  pm.variables.set('seed_wz', '11111111-2222-3333-4444-555555555555');",
                  "} else {",
                  "  pm.variables.set('seed_wz', pm.environment.get('seed_workspace_zettel_id'));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('selection_mode=specific returns 202 async', function () { pm.expect(pm.response.code).to.equal(202); });",
                  "var body = pm.response.json();",
                  "pm.test('Accepted envelope shape', function () { pm.expect(body.status).to.equal('accepted'); });"
                ]
              }
            }
          ],

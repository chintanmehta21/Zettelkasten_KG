{
  "info": {
    "_postman_id": "8c7a55b2-c3c1-4bbf-a97b-zk-kastens",
    "name": "Zettelkasten Create-Kasten E2E",
    "description": "End-to-end Postman/Newman suite for POST /api/rag/sandboxes — the consolidated create_kasten route (new_apis_1a, locked 2026-05-23). Covers: legacy create-only byte-identity, new selection_mode enum (all|source|specific|links|mixed), async 202+poll flow with Retry-After + ETag + 410-on-TTL, Idempotency-Key header honored, DELETE cancel (idempotency-key-bound auth), multi-tenant BOLA, validation, and Supabase row integrity for rag.kastens + rag.kasten_zettels. Mirrors the gating + polling pattern of zettelkasten-summarization.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('run_id')) {",
          "  pm.environment.set('run_id', 'postman-' + Date.now() + '-' + Math.random().toString(36).slice(2));",
          "}",
          "if (!pm.environment.get('latency_events_json')) {",
          "  pm.environment.set('latency_events_json', '[]');",
          "}",
          "// Live gate: skip every request unless explicitly hitting a real target.",
          "if (String(pm.environment.get('run_live_requests') || '').toLowerCase() !== 'true') {",
          "  pm.test('SKIPPED: set run_live_requests=true to hit a real target', function () { pm.expect(true).to.equal(true); });",
          "  pm.execution.skipRequest();",
          "}",
          "// Per-request required-variable gate (mirrors summarization).",
          "var ZK_REQUIRE = {",
          "  'P1 Create Kasten legacy (sync, no members)': ['auth_token_user_a'],",
          "  'P1 Create Kasten selection_mode=all (async)': ['auth_token_user_a'],",
          "  'P1 Create Kasten selection_mode=source (async)': ['auth_token_user_a'],",
          "  'P1 Create Kasten selection_mode=specific (async)': ['auth_token_user_a'],",
          "  'P1 Create Kasten with links (async ingest)': ['auth_token_user_a'],",
          "  'P1 Poll create_kasten operation until terminal': ['auth_token_user_a', 'kasten_op_id'],",
          "  'P1 Idempotency-Key header overrides client_action_id': ['auth_token_user_a'],",
          "  'P1 User B cannot poll User A operation': ['auth_token_user_b', 'kasten_op_id'],",
          "  'P1 User B cannot poll User A operation via unified URL': ['auth_token_user_b', 'kasten_op_id'],",
          "  'P1 DELETE cancel with matching Idempotency-Key': ['auth_token_user_a', 'kasten_op_id_cancel'],",
          "  'P1 DELETE cancel with mismatched key is 403': ['auth_token_user_a', 'kasten_op_id_cancel'],",
          "  'P1 Invalid selection_mode rejected at validator': ['auth_token_user_a'],",
          "  'P1 Invalid kasten name rejected': ['auth_token_user_a'],",
          "  'P1 Invalid URL in links rejected': ['auth_token_user_a'],",
          "  'P2 Supabase rag.kastens row visible': ['supabase_url', 'supabase_service_role_key', 'created_kasten_id'],",
          "  'P2 Supabase rag.kasten_zettels rows scoped': ['supabase_url', 'supabase_service_role_key', 'created_kasten_id']",
          "};",
          "var zkNeeded = ZK_REQUIRE[pm.info.requestName] || [];",
          "var zkMissing = zkNeeded.filter(function (name) { return !pm.environment.get(name); });",
          "if (zkMissing.length) {",
          "  pm.test('SKIPPED: ' + pm.info.requestName + ' needs ' + zkMissing.join(', '), function () { pm.expect(true).to.equal(true); });",
          "  pm.execution.skipRequest();",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "var raw = pm.environment.get('latency_events_json') || '[]';",
          "var events = [];",
          "try { events = JSON.parse(raw); } catch (e) { events = []; }",
          "events.push({",
          "  request: pm.info.requestName,",
          "  folder: pm.info.folderName || '',",
          "  status: pm.response.code,",
          "  elapsed_ms: pm.response.responseTime,",
          "  at: new Date().toISOString()",
          "});",
          "pm.environment.set('latency_events_json', JSON.stringify(events));"
        ]
      }
    }
  ],

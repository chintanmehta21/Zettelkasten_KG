    {
      "name": "P1 Kasten creation flows",
      "item": [
        {
          "name": "P1 Create Kasten legacy (sync, no members)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var id = pm.environment.get('run_id') + ':kasten-legacy';",
                  "pm.variables.set('client_action_id', id);",
                  "pm.variables.set('kasten_name', 'pm-legacy-' + pm.environment.get('run_id').slice(-8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Legacy create-only returns 200', function () { pm.expect(pm.response.code).to.equal(200); });",
                  "var body = pm.response.json();",
                  "pm.test('Byte-identical legacy {sandbox: ...} shape', function () { pm.expect(body).to.have.property('sandbox'); pm.expect(body.sandbox).to.have.property('id'); pm.expect(body.sandbox).to.have.property('name'); pm.expect(body.sandbox.default_quality).to.be.oneOf(['fast', 'high']); });",
                  "pm.test('No async envelope on create-only path', function () { pm.expect(body).to.not.have.property('operation_id'); pm.expect(body).to.not.have.property('status_url'); });",
                  "pm.environment.set('created_kasten_id', body.sandbox.id);"
                ]
              }
            }
          ],

          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token_user_a}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{kasten_name}}\",\n  \"default_quality\": \"fast\",\n  \"links\": [\"{{link_under_test}}\"],\n  \"client_action_id\": \"{{client_action_id}}\"\n}"
            },
            "url": "{{base_url}}/api/rag/sandboxes"
          }
        }
      ]
    },
    {
      "name": "P1 Async operation polling",
      "item": [
        {
          "name": "P1 Poll create_kasten operation until terminal",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var notBefore = Number(pm.environment.get('next_poll_not_before_ms') || 0);",
                  "while (Date.now() < notBefore) { /* local runner wait */ }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "var attempts = Number(pm.environment.get('kasten_poll_attempts') || 0) + 1;",
                  "pm.environment.set('kasten_poll_attempts', String(attempts));",
                  "pm.test('Poll endpoint returns active or terminal contract', function () { pm.expect(pm.response.code).to.be.oneOf([200, 202, 410]); pm.expect(body.operation_id).to.equal(pm.environment.get('kasten_op_id')); });",
                  "if (pm.response.code === 202 && attempts < Number(pm.environment.get('poll_max_attempts') || 90)) {",
                  "  var retryAfter = parseInt(pm.response.headers.get('Retry-After') || '', 10);",
                  "  var baseSleep = Number(pm.environment.get('poll_sleep_ms') || 2000);",
                  "  var waitMs = retryAfter > 0 ? retryAfter * 1000 : Math.min(baseSleep * Math.pow(2, Math.min(attempts - 1, 4)), 30000);",
                  "  pm.environment.set('next_poll_not_before_ms', String(Date.now() + waitMs));",
                  "  postman.setNextRequest('P1 Poll create_kasten operation until terminal');",
                  "} else {",
                  "  pm.environment.unset('kasten_poll_attempts');",
                  "  pm.environment.unset('next_poll_not_before_ms');",
                  "  if (pm.response.code === 202) {",
                  "    pm.test('SOFT: operation still running at poll budget', function () { pm.expect(true).to.equal(true); });",
                  "  } else if (pm.response.code === 410) {",
                  "    pm.test('Expired op returns 410 + RFC 9457 envelope', function () { pm.expect(body.status).to.equal('expired'); pm.expect(body.error).to.be.an('object'); pm.expect(body.error.type).to.match(/operation_expired/); });",
                  "  } else {",
                  "    pm.test('Terminal succeeded carries kasten + selection summary', function () { pm.expect(body.status).to.be.oneOf(['succeeded', 'failed', 'cancelled']); if (body.status === 'succeeded') { pm.expect(body.kasten).to.be.an('object'); pm.expect(body.kasten.id).to.be.a('string'); pm.expect(body.selection).to.be.an('object'); pm.expect(body.selection.resolved_member_count).to.be.a('number'); pm.environment.set('created_kasten_id', body.kasten.id); } });",
                  "    pm.test('Terminal carries ETag + private cache-control', function () { pm.expect(pm.response.headers.get('ETag')).to.match(/^\"[a-f0-9]{16}\"$/); pm.expect(pm.response.headers.get('Cache-Control')).to.match(/private/); });",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token_user_a}}" }
            ],
            "url": "{{base_url}}/api/rag/sandboxes/operations/{{kasten_op_id}}"
          }
        },
        {
          "name": "P1 Unified /api/operations/{id} also serves kasten ops",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unified polling URL responds (D3)', function () { pm.expect(pm.response.code).to.be.oneOf([200, 202, 410]); });",
                  "var body = pm.response.json();",
                  "pm.test('Same operation_id resolves via unified URL', function () { if (body.operation_id) { pm.expect(body.operation_id).to.equal(pm.environment.get('kasten_op_id')); } });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token_user_a}}" }
            ],
            "url": "{{base_url}}/api/operations/{{kasten_op_id}}"
          }
        }
      ]
    },
    {
      "name": "P1 Multi-tenant scoping",
      "item": [
        {
          "name": "P1 User B cannot poll User A operation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User B never receives User A success payload', function () { pm.expect(pm.response.code).to.be.oneOf([200, 202, 404, 410]); });",
                  "pm.test('Response does not leak A workspace identifiers', function () { var txt = pm.response.text(); var leak = pm.environment.get('user_a_workspace_id') || ''; if (leak) { pm.expect(txt.indexOf(leak) === -1, 'leaked user_a_workspace_id').to.equal(true); } });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token_user_b}}" }
            ],
            "url": "{{base_url}}/api/rag/sandboxes/operations/{{kasten_op_id}}"
          }
        },
        {
          "name": "P1 User B cannot poll User A operation via unified URL",
          "event": [
            {

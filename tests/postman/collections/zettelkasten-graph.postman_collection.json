                "exec": [
                  "pm.test('Unknown view returns 400', function () { pm.expect(pm.response.code).to.equal(400); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/graph?view=wrong"
          }
        }
      ]
    },
    {
      "name": "P2 Cache",
      "item": [
        {
          "name": "P1 Cache: repeated view=my within TTL",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Repeat call returns 200', function () { pm.expect(pm.response.code).to.equal(200); });",
                  "pm.test('SOFT: cache hit completes in under 1s', function () { pm.expect(pm.response.responseTime).to.be.below(3000); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token_user_a}}" }
            ],
            "url": "{{base_url}}/api/graph?view=my"
          }
        }
      ]
    }
  ]
}

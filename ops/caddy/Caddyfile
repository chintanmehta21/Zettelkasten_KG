{
    # ACME account email (Let's Encrypt notifications only)
    email chintanoninternet@gmail.com
}

# --- www -> apex 301 redirect ------------------------------------------------
www.zettelkasten.in {
    redir https://zettelkasten.in{uri} permanent
}

# --- apex (canonical) --------------------------------------------------------
zettelkasten.in {
    encode zstd gzip

    # Security headers (applied to every response)
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), camera=(), microphone=()"
        # CSP report-only — observe violations without breaking pages. Once the
        # report stream is quiet for a week + we resolve every legit violation
        # (inline scripts in callback.html, KG visualizer DOM sinks, summary
        # renderer HTML insertion), flip to enforcing Content-Security-Policy.
        # Research basis: synthesis 2026-05-26 R3 — "strict CSP is the real XSS
        # defense; storage choice is secondary." Violations POST to
        # /api/csp-report (see website/api/routes.py).
        # TODO(auth-audit follow-up): replace 'unsafe-inline' on script-src +
        # style-src with per-request nonce/hash injection in templates; biggest
        # inline-script holdouts are callback.html + static/index.html.
        # Reporting-Endpoints header pairs with `report-to` directive — modern
        # Chrome 96+ prefers it over `report-uri`. Both kept for browser parity
        # (Firefox + Safari still on the legacy `report-uri`).
        Reporting-Endpoints "csp-endpoint=\"/api/csp-report\""
        Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://checkout.razorpay.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co https://accounts.google.com https://lumberjack.razorpay.com https://api.razorpay.com https://fonts.googleapis.com https://cloudflareinsights.com; frame-src 'self' https://api.razorpay.com https://accounts.google.com; form-action 'self' https://api.razorpay.com; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests; report-uri /api/csp-report; report-to csp-endpoint"
        # Remove the default Server: Caddy banner
        -Server
    }

    # Long-lived cache for hashed static assets
    @static {
        path /css/* /js/*
        path /m/css/* /m/js/*
        path /kg/css/* /kg/js/*
        path /home/css/* /home/js/*
        path /home/zettels/css/* /home/zettels/js/*
        path /home/nexus/css/* /home/nexus/js/*
        path /about/css/* /about/js/*
        path /pricing/css/* /pricing/js/*
        path /auth/css/* /auth/js/*
        path /artifacts/*
        path /browser-cache/js/*
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # 30s cache for the public KG endpoint (matches in-process TTL)
    @api_graph path /api/graph
    header @api_graph Cache-Control "public, max-age=30"

    # PWA: service worker must never be cached; manifest short-cached by FastAPI (public, 1h)
    @sw {
        path /sw.js
    }
    header @sw Cache-Control "no-cache, max-age=0"
    header @sw Service-Worker-Allowed "/"

    @manifest {
        path /manifest.webmanifest
    }
    header @manifest Cache-Control "public, max-age=3600"

    # Health check always passes through to upstream (bypasses maintenance gate)
    handle /api/health {
        import /etc/caddy/upstream.snippet
    }

    # Edge body-size cap on upload routes (SSRF hardening 2026-05-26).
    # 11MB ceiling on the wire so the app's 10MB cap (zettels_routes.py
    # _MAX_DOCUMENT_UPLOAD_BYTES and routes.py _MAX_BATCH_UPLOAD_BYTES) is
    # the source of the 413 with structured detail — Caddy returns a bare
    # 413 only for grossly-oversize bodies that would still pin memory
    # streaming through. Both layers must agree (app < edge).
    @uploads {
        method POST
        path /api/zettels/add/document /api/v2/batch/upload
    }
    request_body @uploads {
        max_size 11MB
    }

    # Maintenance flag file → 503 (close connection so clients don't retry against a stale upstream)
    @maintenance file /etc/caddy/maintenance.flag
    handle @maintenance {
        respond "Service is under maintenance. We'll be back shortly." 503 {
            close
        }
    }

    # Normal traffic — application reverse proxy (upstream is hot-swappable)
    handle {
        import /etc/caddy/upstream.snippet
    }

    # Access log (JSON, separate file for logrotate)
    log {
        output file /var/log/caddy/access.log {
            roll_size 10MiB
            roll_keep 5
            roll_keep_for 168h
        }
        format json
    }
}
